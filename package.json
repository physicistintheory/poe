{
	"name": "poe",
	"version": "0.1.0",
	"displayName": "Panel of Experts",
	"description": "Cursor plugin supporting vibe coding with a panel of AI expert agents",
	"main": "dist/index.js",
	"publisher": "fluidmind",
	"engines": {
		"vscode": "^1.81.0"
	},
	"activationEvents": [
		"onStartupFinished",
		"onCommand:poe.startPanel",
		"onCommand:poe.resetConversation",
		"onView:poe-panel"
	],
	"contributes": {
		"commands": [
			{
				"command": "poe.startPanel",
				"title": "Start Panel of Experts Discussion"
			},
			{
				"command": "poe.toggleAutoDiscuss",
				"title": "Toggle Auto-Discussion Mode"
			},
			{
				"command": "poe.resetConversation",
				"title": "Reset Conversation"
			},
			{
				"command": "poe.forceSetOllamaModel",
				"title": "Force Set Ollama Model (Fast)"
			},
			{
				"command": "poe.clearPanelStorage",
				"title": "Clear Panel Storage (Reset Models)"
			},
			{
				"command": "poe.forceRefreshModels",
				"title": "Force Refresh All Models"
			},
			{
				"command": "poe.showCurrentModels",
				"title": "Show Current Model Configuration"
			}
		],
		"configuration": {
			"title": "Panel of Experts",
			"properties": {
				"poe.openaiApiKey": {
					"type": "string",
					"default": "",
					"description": "OpenAI API Key for GPT models",
					"scope": "application"
				},
				"poe.openaiDefaultModel": {
					"type": "string",
					"default": "gpt-4o-mini",
					"description": "Default OpenAI model to use",
					"scope": "application"
				},
				"poe.openaiBaseUrl": {
					"type": "string",
					"default": "https://api.openai.com/v1",
					"description": "OpenAI API base URL (for custom endpoints)",
					"scope": "application"
				},
				"poe.anthropicApiKey": {
					"type": "string",
					"default": "",
					"description": "Anthropic API Key for Claude models",
					"scope": "application"
				},
				"poe.anthropicDefaultModel": {
					"type": "string",
					"default": "claude-3-5-sonnet-20241022",
					"description": "Default Anthropic model to use",
					"scope": "application"
				},
				"poe.geminiApiKey": {
					"type": "string",
					"default": "",
					"description": "Gemini API Key for Google AI services",
					"scope": "application"
				},
				"poe.geminiDefaultModel": {
					"type": "string",
					"default": "gemini-1.5-pro",
					"description": "Default Gemini model to use",
					"scope": "application"
				},
				"poe.ollamaBaseUrl": {
					"type": "string",
					"default": "http://localhost:11434",
					"description": "Ollama server base URL",
					"scope": "application"
				},
				"poe.ollamaTimeout": {
					"type": "number",
					"default": 30000,
					"description": "Timeout for Ollama requests in milliseconds",
					"scope": "application"
				},
				"poe.ollamaDefaultModel": {
					"type": "string",
					"default": "llama3.2:1b",
					"description": "Default Ollama model to use for experts and moderator",
					"scope": "application"
				},
				"poe.defaultProvider": {
					"type": "string",
					"default": "openai",
					"description": "Default AI provider to use",
					"enum": ["openai", "anthropic", "gemini", "ollama"],
					"enumDescriptions": [
						"OpenAI GPT models",
						"Anthropic Claude models",
						"Google Gemini models",
						"Local Ollama models"
					],
					"scope": "application"
				},
				"poe.maxTokens": {
					"type": "number",
					"default": 4000,
					"description": "Maximum tokens for AI responses",
					"scope": "application"
				},
				"poe.temperature": {
					"type": "number",
					"default": 0.7,
					"description": "Temperature setting for AI responses (0.0-2.0)",
					"scope": "application"
				}
			}
		},
		"settingsUi": {
			"path": "./resources/settings-ui.json"
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "poe-container",
					"title": "Panel of Experts",
					"icon": "resources/expert-panel.svg"
				}
			]
		},
		"views": {
			"poe-container": [
				{
					"id": "poe-panel",
					"name": "Panel of Experts",
					"icon": "resources/expert-panel.svg",
					"type": "webview"
				}
			]
		},
		"iconThemes": [
			{
				"id": "poe-icons",
				"label": "Panel of Experts Icons",
				"path": "./resources/icon-theme.json"
			}
		]
	},
	"scripts": {
		"build": "tsc && cp -r resources dist/",
		"dev": "tsc --watch",
		"test": "jest",
		"test:e2e": "for test in tests/e2e/*.test.js; do echo \"Running $test...\"; node \"$test\"; echo \"\"; done",
		"test:e2e:integration": "node tests/e2e/agentic-loop-integration.test.js",
		"test:e2e:logic": "node tests/e2e/agentic-loop-logic.test.js",
		"test:e2e:debug": "node tests/e2e/agentic-loop-debug.test.js",
		"test:e2e:moderator": "node tests/e2e/moderator-behavior.test.js",
		"test:e2e:rotation": "node tests/e2e/expert-rotation.test.js",
		"test:e2e:length": "node tests/e2e/expert-response-length.test.js",
		"lint": "eslint src/**/*.ts",
		"prepare": "husky install",
		"precommit": "npm run lint && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.41.0",
		"@google-ai/generativelanguage": "^2.0.0",
		"dotenv": "^16.3.1",
		"openai": "^4.20.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"@types/jest": "^29.5.4",
		"@types/node": "^20.9.0",
		"@types/react": "^18.2.15",
		"@types/react-dom": "^18.2.7",
		"@types/uuid": "^9.0.8",
		"@types/vscode": "^1.81.0",
		"@typescript-eslint/eslint-plugin": "^6.10.0",
		"@typescript-eslint/parser": "^6.10.0",
		"eslint": "^8.53.0",
		"eslint-plugin-react": "^7.37.5",
		"husky": "^8.0.3",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.1",
		"typescript": "^5.2.2"
	},
	"keywords": [
		"cursor",
		"ide",
		"plugin",
		"ai",
		"llm",
		"chatbot"
	],
	"author": "",
	"license": "MIT",
	"__metadata": {
		"size": 109857939
	}
}
