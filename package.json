{
	"name": "poe",
	"version": "0.1.0",
	"displayName": "Panel of Experts",
	"description": "Cursor plugin supporting vibe coding with a panel of AI expert agents",
	"main": "dist/index.js",
	"publisher": "fluidmind",
	"engines": {
		"vscode": "^1.81.0"
	},
	"activationEvents": [
		"onStartupFinished",
		"onCommand:poe.startPanel",
		"onCommand:poe.resetConversation",
		"onView:poe-panel"
	],
	"contributes": {
		"commands": [
			{
				"command": "poe.startPanel",
				"title": "Start Panel of Experts Discussion"
			},
			{
				"command": "poe.toggleAutoDiscuss",
				"title": "Toggle Auto-Discussion Mode"
			},
			{
				"command": "poe.resetConversation",
				"title": "Reset Conversation"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "poe-container",
					"title": "Panel of Experts",
					"icon": "resources/expert-panel.svg"
				}
			]
		},
		"views": {
			"poe-container": [
				{
					"id": "poe-panel",
					"name": "Panel of Experts",
					"icon": "resources/expert-panel.svg",
					"type": "webview"
				}
			]
		},
		"iconThemes": [
			{
				"id": "poe-icons",
				"label": "Panel of Experts Icons",
				"path": "./resources/icon-theme.json"
			}
		]
	},
	"scripts": {
		"build": "tsc && cp -r resources dist/",
		"dev": "tsc --watch",
		"test": "jest --passWithNoTests",
		"lint": "eslint src/**/*.ts",
		"prepare": "husky install",
		"precommit": "npm run lint && npm run test && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.41.0",
		"@google-ai/generativelanguage": "^2.0.0",
		"dotenv": "^16.3.1",
		"openai": "^4.20.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"@types/jest": "^29.5.4",
		"@types/node": "^20.9.0",
		"@types/react": "^18.2.15",
		"@types/react-dom": "^18.2.7",
		"@types/uuid": "^9.0.8",
		"@types/vscode": "^1.81.0",
		"@typescript-eslint/eslint-plugin": "^6.10.0",
		"@typescript-eslint/parser": "^6.10.0",
		"eslint": "^8.53.0",
		"eslint-plugin-react": "^7.33.2",
		"husky": "^8.0.3",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.1",
		"typescript": "^5.2.2"
	},
	"keywords": [
		"cursor",
		"ide",
		"plugin",
		"ai",
		"llm",
		"chatbot"
	],
	"author": "",
	"license": "MIT",
	"__metadata": {
		"size": 109857939
	}
}
